# 실시간 시세 API를 연동할 때 사용할 환경 변수 예시입니다.
# 실제 키는 .env 파일에 넣고, .env는 절대 커밋하지 마세요 (.gitignore에 포함됨).
# Vite에서는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출됩니다.

# 예: 시세 제공 API 키
# VITE_MARKET_API_KEY=your_api_key_here

# 예: API 베이스 URL
# VITE_MARKET_API_BASE=https://api.example.com

# ─────────────────────────────────────────────────────────────
# 네이버 블로그 일일 요약 스크래퍼 (scraper/) — GitHub Secrets/Variables 로 주입
# 로컬 테스트 시에는 .env 대신 셸에서 export 해서 사용하세요.
# ─────────────────────────────────────────────────────────────
# 대상 블로그 아이디 (기본: ranto28)
# BLOG_ID=ranto28
# 배포된 사이트 주소 (카카오 링크에 사용). 예: https://history-archive.pages.dev
# SITE_BASE_URL=https://your-site.example.com
# 한 번에 처리할 최대 새 글 수 (기본: 5)
# MAX_POSTS=5

# Claude API 키 (본문·댓글 요약)
# ANTHROPIC_API_KEY=sk-ant-...
# 모델 오버라이드 (선택)
# ANTHROPIC_MODEL=claude-opus-4-8

# 카카오톡 "나에게 보내기" 전송용
# KAKAO_REST_API_KEY=...
# KAKAO_REFRESH_TOKEN=...
